def Xform "Panel1"
{
    def "Looks"
    {
        def Material "backboard"
        {
            token outputs:surface.connect = </Panel1/Looks/backboard/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.6, 0.57, 0.48)
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }

