def Xform "World"
{
    def Scope "DisplayPlayback" (
        prepend apiSchemas = ["OmniScriptingAPI"]
    )
    {
        asset[] omni:scripting:scripts = [@../scripts/press_cp_play_behavior.py@]
    }

    def Xform "Cabinet" (
        prepend references = @../assets/cp_panel/press_cp_cabinet.usda@
    )
    {
    }

    def Xform "Workcell" (
        prepend references = @../assets/environment/workcell.usda@
    )
    {
    }

